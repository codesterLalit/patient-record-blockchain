# .env.example
# Copy this to .env and fill in your real values.
# NEVER commit .env to version control — add it to .gitignore.

# Alchemy Sepolia RPC endpoint
ALCHEMY_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Deployed contract address (from Remix after deployment)
CONTRACT_ADDR=0xYourDeployedContractAddress

# Account 1 — Owner (deploy from this account in Remix)
OWNER_ADDR=0xYourOwnerAddress
OWNER_KEY=your_owner_private_key_hex

# Account 2 — Provider (second doctor)
PROVIDER2_ADDR=0xYourSecondDoctorAddress
PROVIDER2_KEY=your_provider2_private_key_hex
